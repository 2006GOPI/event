# ==========================================
# ATLAS Workspace Root Environment Variables
# ==========================================

# Environment Mode: development | production | test
ENVIRONMENT=development

# Backend Settings
PROJECT_NAME="ATLAS Workspace"
API_V1_STR="/api/v1"
SECRET_KEY="atlas-workspace-development-secret-key-change-in-production-2026"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database: SQLite for local zero-config dev, PostgreSQL for production
# Local SQLite fallback: sqlite:///./atlas.db
# PostgreSQL: postgresql+psycopg2://postgres:postgres@localhost:5432/atlas_workspace
DATABASE_URL="sqlite:///./atlas.db"

# CORS configuration (comma-separated origins)
CORS_ORIGINS="http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174"

# Optional External AI Provider (backend-only, leave empty for built-in rule-based intelligence)
AI_PROVIDER=""
AI_API_KEY=""
AI_MODEL_NAME="gemini-1.5-flash"

# Optional Google OAuth (leave empty if not configured)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Frontend Settings (served on :5174 if :5173 is busy)
VITE_API_BASE_URL="http://localhost:8000/api/v1"
